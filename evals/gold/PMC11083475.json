{
  "in_scope": true,
  "out_of_scope_reason": null,
  "intended_application": "active packaging and freshness indicator for meat and seafood",
  "process_steps": [
    {
      "order": 1,
      "stage": "film_formation",
      "type": "mixing",
      "description": "EWP, glycerol and alginate dispersed in distilled water",
      "source": {
        "section": "methods",
        "quote": "EWP dispersions were obtained by dispersing 9 g of EWP in 300 mL of distilled water and adding 9 g of glycerol with different concentrations of Alg"
      }
    },
    {
      "order": 2,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Stirred at 400 rpm",
      "temperature_c": 45,
      "duration_value": 3,
      "duration_unit": "h",
      "source": {
        "section": "methods",
        "quote": "After stirring at 45 °C for 3 h under magnetic stirring at 400 rpm"
      }
    },
    {
      "order": 3,
      "stage": "film_formation",
      "type": "other",
      "description": "Alkalised to pH 11.0 with NaOH and stirred",
      "ph": 11.0,
      "duration_value": 20,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "the dispersion was alkalized to pH of 11.0 with 2 mol/L NaOH followed by stirring of the mixture for 20 min"
      }
    },
    {
      "order": 4,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Curcumin added and stirred in the dark without oxygen",
      "duration_value": 20,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "curcumin was added to the solution of EWP at a concentration of 2 mg/mL, after which the mixture was stirred for 20 min in an environment with no light source and under anaerobic conditions"
      }
    },
    {
      "order": 5,
      "stage": "film_formation",
      "type": "other",
      "description": "Neutralised to pH 7.0 with HCl",
      "ph": 7.0,
      "source": {
        "section": "methods",
        "quote": "The mixture was then neutralized to pH 7.0 with 2 mol/L HCl"
      }
    },
    {
      "order": 6,
      "stage": "film_formation",
      "type": "centrifuging",
      "description": "Centrifuged at 8000 rpm",
      "duration_value": 10,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "this mixture was centrifuged at 8000 rpm for 10 min"
      }
    },
    {
      "order": 7,
      "stage": "film_formation",
      "type": "degassing",
      "description": "Degassed in a vacuum dryer",
      "duration_value": 30,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "All solution samples were evacuated in a vacuum dryer for 30 min to remove all foaming"
      }
    },
    {
      "order": 8,
      "stage": "film_formation",
      "type": "casting",
      "description": "Cast onto a 200 mm × 200 mm PTFE plate",
      "source": {
        "section": "methods",
        "quote": "cast onto a 200 mm × 200 mm × 6 mm PTFE plate, which was then dried at 50 °C for a continuous period of 12 h"
      }
    },
    {
      "order": 9,
      "stage": "film_formation",
      "type": "drying",
      "description": "Dried",
      "temperature_c": 50,
      "duration_value": 12,
      "duration_unit": "h",
      "source": {
        "section": "methods",
        "quote": "cast onto a 200 mm × 200 mm × 6 mm PTFE plate, which was then dried at 50 °C for a continuous period of 12 h"
      }
    }
  ],
