      "description": "Microwave-assisted extraction in water, 0.05 g plant/mL, 500 W",
      "temperature_c": 70,
      "duration_value": 10,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "(a) solvent/water; (b) solvent/plant ratio—0.05 g plant/mL; (c) extraction time—10 min; (d) cycle power and temperature—500 W and 70 °C"
      }
    },
    {
      "order": 3,
      "stage": "ingredient_preparation",
      "type": "filtering",
      "description": "Extract filtered through cellulose filter paper",
      "source": {
        "section": "methods",
        "quote": "the sample was filtered (through 100% cellulose filter paper)"
      }
    },
    {
      "order": 4,
      "stage": "film_formation",
      "type": "dissolving",
      "description": "Polymer dispersion mixed with a magnetic stirrer until fully dissolved",
      "source": {
        "section": "methods",
        "quote": "the individual polymer dispersions were mixed using a magnetic stirrer (Delab MS-H280-S4, Beijing, China) to achieve complete polymer dissolution"
      }
    },
    {
      "order": 5,
      "stage": "film_formation",
      "type": "homogenising",
      "description": "Homogenised at 12,000 rpm",
      "duration_value": 5,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "Homogenization was performed using homogenizer (IKA Ultra turax T18, Staufen, Germany) at 12,000 rpm for 5 min"
      }
    },
    {
      "order": 6,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Stirred with a magnetic stirrer at 600 rpm",
      "duration_value": 30,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "followed by continuous stirring in a magnetic stirrer at 600 rpm for 30 min"
      }
    },
    {
      "order": 7,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Lemon balm extract added to 10% (v/v)",
      "source": {
        "section": "methods",
        "quote": "lemon balm extract (Melissa officinalis) (E) was added to the dispersions to obtain concentration of 10% (v/v)"
      }
    },
    {
      "order": 8,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Glycerol added as plasticizer",
      "source": {
        "section": "methods",
        "quote": "Afterwards, glycerol was added as a plasticizer"
      }
    },
    {
      "order": 9,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Final dispersion stirred at room temperature",
      "temperature_c": 23,
      "duration_value": 10,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "The final film-forming dispersions were stirred for additional 10 min at room temperature (23 ± 2 °C)"
      }
    },
    {
      "order": 10,
      "stage": "film_formation",
      "type": "casting",
      "description": "30 mL poured into a 150 mm Petri dish",
      "source": {
        "section": "methods",
        "quote": "a defined volume (30 mL) was poured on a Petri dish (150 mm diameter)"
      }
    },
    {
      "order": 11,
      "stage": "film_formation",
      "type": "drying",
      "description": "Dried in a ventilated climatic chamber at 40% RH",
