        "quote": "This dispersion was heated to a temperature of 62 °C, then 2% v/v sorbitol was added and continued to heat up to 80 °C"
      }
    },
    {
      "order": 7,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Sorbitol added",
      "source": {
        "section": "methods",
        "quote": "This dispersion was heated to a temperature of 62 °C, then 2% v/v sorbitol was added and continued to heat up to 80 °C"
      }
    },
    {
      "order": 8,
      "stage": "film_formation",
      "type": "heating",
      "description": "Heated further to 80 °C",
      "temperature_c": 80,
      "source": {
        "section": "methods",
        "quote": "This dispersion was heated to a temperature of 62 °C, then 2% v/v sorbitol was added and continued to heat up to 80 °C"
      }
    },
    {
      "order": 9,
      "stage": "film_formation",
      "type": "sonicating",
      "description": "Sonicated at 40% amplitude",
      "duration_value": 10,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "sonicated at 40% amplitude for 10 min"
      }
    },
    {
      "order": 10,
      "stage": "film_formation",
      "type": "degassing",
      "description": "Degassed in an ultrasound bath",
      "duration_value": 15,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "The film-forming material was degassed in an ultrasound bath for 15 min"
      }
    },
    {
      "order": 11,
      "stage": "film_formation",
      "type": "casting",
      "description": "Poured into a 20 cm × 20 cm glass plate mould",
