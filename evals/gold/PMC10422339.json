      "type": "sonicating",
      "description": "Emulsion sonicated at 65% amplitude",
      "duration_value": 5,
      "duration_unit": "min",
      "source": {
        "section": "methods",
        "quote": "The emulsion was then sonicated for 5 min with an amplitude of 65% to make it homogeneous"
      }
    },
    {
      "order": 3,
      "stage": "film_formation",
      "type": "mixing",
      "description": "Starch and CMC dispersed in distilled water with a magnetic stirrer",
      "source": {
        "section": "methods",
        "quote": "An amount of 7 g of starch and 0.5% w/v CMC were dispersed in 85 mL of distilled water using a magnetic stirrer"
      }
    },
    {
      "order": 4,
      "stage": "ingredient_preparation",
      "type": "mixing",
      "description": "NCC dispersed in distilled water",
      "source": {
        "section": "methods",
        "quote": "disperse NCC as much as 5 wt% in 15 mL of distilled water and stirred until homogeneous"
      }
    },
    {
      "order": 5,
      "stage": "film_formation",
      "type": "homogenising",
      "description": "NCC dispersion and VCO emulsion poured slowly into the starch solution while homogenising",
      "source": {
        "section": "methods",
        "quote": "The dispersed NCC and the VCO emulsion were poured slowly into the starch solution while homogenizing"
      }
    },
    {
      "order": 6,
      "stage": "film_formation",
      "type": "heating",
      "description": "Heated to 62 °C",
      "temperature_c": 62,
      "source": {
